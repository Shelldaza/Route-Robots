{
  "compilerOptions": {
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.app.tsbuildinfo",

    "target": "es2023",
    "lib": ["ES2023", "DOM"],
    "module": "esnext",
    "types": ["vite/client"],

    "allowArbitraryExtensions": true,
    "skipLibCheck": true,

    /* Resolución de módulos para Vite. */
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "moduleDetection": "force",

    /* Vite genera los archivos finales; TypeScript comprueba los tipos. */
    "noEmit": true,
    "jsx": "react-jsx",

    /*
     * Activa las comprobaciones estrictas:
     * estados nulos, parámetros sin tipo y compatibilidad de funciones,
     * entre otras verificaciones incluidas por TypeScript.
     */
    "strict": true,

    /* Detecta código sin uso y construcciones incompatibles. */
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "erasableSyntaxOnly": true,
    "noFallthroughCasesInSwitch": true
  },
  "include": ["src"]
}